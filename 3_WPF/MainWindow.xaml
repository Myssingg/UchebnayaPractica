<Window x:Class="_3_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3_WPF"
        mc:Ignorable="d"
    Title="Autorize" Height="430" Width="400"
    FontFamily="Tahoma" FontSize="14">
    <StackPanel Background="Azure" Margin="10">
        <TextBlock x:Name="timerText" FontSize="18" FontWeight="Black" Visibility="Collapsed" Foreground="Red"/>

        <TextBlock Text="Логин" HorizontalAlignment="Center" Padding="5" Margin="0,30,0,0"/>
        <TextBox x:Name="textBox_Login" Padding="5" Width="200" Height="30"/>

        <TextBlock Text="Пароль" HorizontalAlignment="Center" Padding="5" Margin="0,5,0,0"/>
        <WrapPanel Width="240" Orientation="Horizontal" Margin="40,0,0,0">
            <TextBox x:Name="textBox_Password" Padding="5" Width="200" Height="30" Visibility="Collapsed"/>
            <PasswordBox x:Name="passwordBox_Password" Width="200" Height="30" Padding="5" Visibility="Visible"/>
            <ToggleButton x:Name="toggle" 
                          Checked="toggle_Checked" 
                          Unchecked="toggle_Unchecked" 
                          Width="30" 
                          Height="30" 
                          Margin="10,0,0,0" 
                          Padding="5"
                          Content="*" 
                          VerticalContentAlignment="Center" 
                          HorizontalContentAlignment="Center"/>
        </WrapPanel>

        <Button Margin="0,30,0,0" Content="Войти" Padding="5" Width="200" x:Name="btn_Login" Click="btn_Login_Click"/>

        <Label Name="IncorrectPassword" Visibility="Hidden" Foreground="DarkRed" Content="Неверный пароль! Введите капчу" HorizontalAlignment="Center"/>
        <WrapPanel Name="Captcha" HorizontalAlignment="Center" Visibility="Hidden">
            <TextBlock Name="CaptchaBlock" Foreground="DarkRed" FontSize="32" TextDecorations="Strikethrough" FontStyle="Italic" FontFamily="Comic Sans MS"/>
            <TextBox Name="CaptchaText" Margin="25,0,0,0" Width="125" Height="25"/>
            <Button Name="generateCaptcha" Content="Сгенерировать новую капчу" Click="generateCaptcha_Click"/>
        </WrapPanel>

    </StackPanel>
</Window>
