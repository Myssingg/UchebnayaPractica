<Window x:Class="_3_WPF.DialogAddServices"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3_WPF"
        mc:Ignorable="d"
        Title="DialogAddServices" Height="450" Width="600"
        FontFamily="Tahoma" FontSize="14">
    <StackPanel Orientation="Vertical" Background="Azure" Margin="10">
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="30"/>

                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Услуга" Padding="5" Grid.Row="0"/>
            <ComboBox x:Name="comboBox_services" Padding="5" Grid.Row="1" SelectionChanged="comboBox_services_SelectionChanged"/>

            <TextBlock Text="Количество" Padding="5" Grid.Row="2"/>
            <TextBox x:Name="textBox_Count" Padding="5" Grid.Row="3"/>

            <TextBlock Text="Цена за ед." Padding="5" Grid.Row="4"/>
            <TextBox IsReadOnly="True" x:Name="textBox_Price" Padding="5" Grid.Row="5"/>

            <Button Content="Добавить услугу" Grid.Row="6" Padding="5" Margin="5" Click="Button_Click"/>

            <ListView x:Name="list" Grid.RowSpan="8" Grid.Column="1"/>


            <TextBlock Text="Стоимость:" Padding="5" Grid.Column="0" Grid.Row="8" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <TextBox x:Name="textBox_sumPrice" Padding="5" IsReadOnly="True" Grid.Column="1" Grid.Row="8" VerticalAlignment="Center" Width="150" HorizontalAlignment="Left" Text="0"/>

            <Button Content="Оформить заказ" Padding="5" Grid.ColumnSpan="2" Grid.Row="9" HorizontalAlignment="Center" VerticalAlignment="Center" Width="150" x:Name="btn_Next" Click="btn_Next_Click"/>
        </Grid>
    </StackPanel>
</Window>
