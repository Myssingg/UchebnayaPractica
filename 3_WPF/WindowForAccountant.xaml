<Window x:Class="_3_WPF.WindowForAccountant"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3_WPF"
        mc:Ignorable="d"
        Title="WindowForAccountant" Height="450" Width="400"
        FontFamily="Tahoma" FontSize="14" ResizeMode="NoResize">
    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal">
            <Image x:Name="avatar" Height="50" Width="50" Margin="5" Stretch="UniformToFill"/>
            <WrapPanel Orientation="Vertical">
                <TextBlock x:Name="userInfo" Margin="5" VerticalAlignment="Center" FontSize="18"/>
                <TextBlock x:Name="Timer" FontSize="18" FontWeight="Black" VerticalAlignment="Center"/>
            </WrapPanel>
        </StackPanel>

        <TabControl Margin="10" Background="Azure">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 1. Верхняя панель (Заголовки + Кнопка) -->
                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <!-- Место, где WPF рисует ваши TabItem (Товары, Заказы) -->
                            <TabPanel IsItemsHost="True" DockPanel.Dock="Left" VerticalAlignment="Bottom" />

                            <!-- Ваша реальная кнопка "Выйти" справа -->
                            <Button Content="Выйти" 
                    Click="TabItem_Click" 
                    DockPanel.Dock="Right" 
                    Margin="0,0,5,0"    
                    Padding="10,2"
                    Background="#FFECECEC" />
                        </DockPanel>

                        <!-- 2. Область контента (само содержимое вкладок) -->
                        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="0,1,0,0">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabItem Header="Просмотр отчетов" x:Name="tab_viewReports">
                <Grid Margin="10">
                    <DataGrid x:Name="dgBills" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№ Счета" Binding="{Binding code}" Width="Auto" />
                            <DataGridTextColumn Header="Компания" Binding="{Binding insuranceCompany.name}" Width="*" />
                            <DataGridTextColumn Header="Сумма" Binding="{Binding summ, StringFormat=\{0:N2\} руб.}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Сформировать счет" x:Name="tab_createBill">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgOrders" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№ Заказа" Binding="{Binding code}" Width="Auto" />
                            <DataGridTextColumn Header="Дата" Binding="{Binding dateTime, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="*" />
                            <DataGridTextColumn Header="Пациент" Binding="{Binding patients.surname}" Width="*" />
                            <DataGridTextColumn Header="Компания" Binding="{Binding patients.insuranceCompany.name}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Content="Сформировать счет" 
                    Grid.Row="1" 
                    Margin="0,10,0,0" 
                    Padding="20,10" 
                    HorizontalAlignment="Right" 
                    Click="btnCreateBill_Click" />
                </Grid>
            </TabItem>

        </TabControl>
    </StackPanel>
</Window>
